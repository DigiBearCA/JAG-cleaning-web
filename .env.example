# EmailJS credentials for the quote form (server-side only, never prefix with NEXT_PUBLIC_).
# Copy to .env.local for development and add the same four variables in your hosting dashboard.
# In development, if any are missing the API logs the quote to the terminal and returns success.
# In production, if any are missing the API returns 503 and the form shows the call/WhatsApp fallback.

# EmailJS > Email Services > your service > Service ID
EMAILJS_SERVICE_ID=
# EmailJS > Email Templates > your template > Template ID
EMAILJS_TEMPLATE_ID=
# EmailJS > Account > General > Public Key
EMAILJS_PUBLIC_KEY=
# EmailJS > Account > General > Private Key (also enable "Allow EmailJS API for non-browser applications" under Account > Security)
EMAILJS_PRIVATE_KEY=
